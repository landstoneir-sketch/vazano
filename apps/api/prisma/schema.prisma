generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SecurityEventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CmsPublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrganizationType {
  INDIVIDUAL
  COMPANY
}

enum OrganizationKind {
  BUYER
  SUPPLIER
  PLATFORM
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  BUYER_OWNER
  BUYER_MEMBER
  SUPPLIER_OWNER
  SUPPLIER_MANAGER
  SUPPLIER_SALES
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  RESET
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RfqEntryMethod {
  STANDARD
  CONVERSATIONAL
  BOQ
  IMAGE
  DRAWING
  NAMEPLATE
  FILE
}

enum RfqLifecycleState {
  DRAFT
  SUBMITTED
  PUBLISHED
  CLOSED
  CANCELLED
  EXPIRED
  ARCHIVED
}

enum RfqOperationalStatus {
  DRAFT_INCOMPLETE
  READY_FOR_REVIEW
  UNDER_REVIEW
  NEEDS_CHANGES
  WAITING_COMMITMENT
  READY_TO_PUBLISH
  OPEN_FOR_QUOTES
  HAS_QUOTES
  NEGOTIATING
  SELLER_SELECTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RfqApprovalStatus {
  NOT_SUBMITTED
  PENDING
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum RfqSource {
  BUYER_SELF_SERVICE
  PLATFORM_OPERATOR
}

enum CommitmentStatus {
  NOT_REQUIRED
  REQUIRED
  PAYMENT_PENDING
  HELD
  RELEASED_TO_WALLET
  REFUND_PENDING
  REFUNDED
  FORFEITED
}

enum ProductAttributeDataType {
  TEXT
  NUMBER
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  GRACE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  P1M
  P3M
  P6M
  P1Y
  CUSTOM
}

enum ReminderChannel {
  SMS
  IN_APP
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  READY
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationDispatchStatus {
  PROCESSED
  FAILED
}

enum AttachmentStatus {
  PENDING_UPLOAD
  PENDING_SCAN
  READY
  QUARANTINED
  REJECTED
  DELETED
}

enum AttachmentPurpose {
  GENERAL
  PRODUCT_IMAGE
  DRAWING
  BILL_OF_QUANTITIES
  SPECIFICATION
  PROFORMA
  CERTIFICATE
}

enum MessageThreadStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageKind {
  USER
  SYSTEM
}

enum PaymentProvider {
  ZARINPAL
  MOCK
}

enum PaymentPurpose {
  SUBSCRIPTION
  BUYER_COMMITMENT
  QUALITY_CONTROL
}

enum PaymentStatus {
  CREATED
  REDIRECT_PENDING
  VERIFY_PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum PaymentReconciliationStatus {
  NOT_CHECKED
  MATCHED
  ACTION_REQUIRED
  PROVIDER_UNCONFIRMED
}

enum PaymentReconciliationResolution {
  CUSTOMER_RETRY_REQUIRED
  PROVIDER_SUPPORT_REQUIRED
  REFUND_REVIEW_REQUIRED
  NO_FINANCIAL_ACTION
}

enum BillingInvoicePurpose {
  SUBSCRIPTION
  QUALITY_CONTROL
  CONTRACT_SERVICE
}

enum BillingInvoiceStatus {
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum SubscriptionDiscountType {
  PERCENTAGE
  FIXED_RIAL
}

enum DiscountRedemptionStatus {
  RESERVED
  REDEEMED
  CANCELLED
}

enum CreditEntryType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
  REFUND
  EXPIRE
  ADJUSTMENT
}

enum QualityControlStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ContractRequestStatus {
  REQUESTED
  UNDER_REVIEW
  TERMS_PREPARED
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum SupplierVerificationStatus {
  INCOMPLETE
  PENDING
  VERIFIED
  NEEDS_CORRECTION
  REJECTED
  SUSPENDED
}

enum RfqInvitationStatus {
  INVITED
  VIEWED
  RESPONDED
  DECLINED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  REVISED
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SupportTicketType {
  QUESTION
  SERVICE_REQUEST
  ISSUE
  COMPLAINT
  VIOLATION_REPORT
  APPEAL
}

enum SupportTicketCategory {
  PRODUCT_TECHNICAL
  ACCOUNT_ACCESS
  RFQ
  QUOTATION
  SUPPLIER_BUYER_CONDUCT
  BILLING
  PRIVACY_SECURITY
  COMMUNICATION
  POLICY
  OTHER
}

enum SupportTicketPriority {
  P1
  P2
  P3
  P4
}

enum SupportTicketStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_REVIEW
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REJECTED
}

enum SupplierReviewStatus {
  PUBLISHED
  HIDDEN
}

model User {
  id                      String                   @id @default(cuid())
  mobile                  String                   @unique
  email                   String?                  @unique
  firstName               String?                  @map("first_name")
  lastName                String?                  @map("last_name")
  locale                  String                   @default("fa-IR")
  status                  UserStatus               @default(ACTIVE)
  mobileVerifiedAt        DateTime?                @map("mobile_verified_at") @db.Timestamptz(3)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships             OrganizationMember[]
  sessions                Session[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  createdRfqs             Rfq[]                    @relation("RfqCreator")
  buyerContactRfqs        Rfq[]                    @relation("RfqBuyerContact")
  operatedRfqs            Rfq[]                    @relation("RfqOperator")
  createdQuotations       Quotation[]              @relation("QuotationCreator")
  notifications           Notification[]
  uploadedAttachments     Attachment[]             @relation("AttachmentUploader")
  sentMessages            Message[]                @relation("MessageSender")
  messageReadStates       MessageThreadReadState[]
  requestedSupportTickets SupportTicket[]          @relation("SupportTicketRequester")
  assignedSupportTickets  SupportTicket[]          @relation("SupportTicketAssignee")
  supportComments         SupportTicketComment[]   @relation("SupportCommentAuthor")
  securityEvents          SecurityEvent[]          @relation("SecurityEventSubject")
  resolvedSecurityEvents  SecurityEvent[]          @relation("SecurityEventResolver")
  updatedCmsPages         CmsPage[]                @relation("CmsPageUpdater")
  updatedFaqItems         FaqItem[]                @relation("FaqItemUpdater")
  requestedContracts      ContractRequest[]        @relation("ContractRequester")
  resolvedPaymentReconciliations PaymentIntent[]   @relation("PaymentReconciliationResolver")
  manualSubscriptionRenewals ManualSubscriptionRenewal[] @relation("ManualSubscriptionRenewalActor")
  createdSupplierReviews SupplierReview[] @relation("SupplierReviewCreator")
  moderatedSupplierReviews SupplierReview[] @relation("SupplierReviewModerator")

  @@map("users")
}

model CmsPage {
  id               String               @id @default(cuid())
  slug             String               @unique
  titleFa          String               @map("title_fa")
  excerptFa        String?              @map("excerpt_fa")
  bodyFa           String               @map("body_fa") @db.Text
  seoTitleFa       String?              @map("seo_title_fa")
  seoDescriptionFa String?              @map("seo_description_fa")
  status           CmsPublicationStatus @default(DRAFT)
  version          Int                  @default(1)
  publishedAt      DateTime?            @map("published_at") @db.Timestamptz(3)
  updatedByUserId  String               @map("updated_by_user_id")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        User                 @relation("CmsPageUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([status, updatedAt])
  @@map("cms_pages")
}

model FaqItem {
  id              String   @id @default(cuid())
  questionFa      String   @map("question_fa")
  answerFa        String   @map("answer_fa") @db.Text
  category        String?
  sortOrder       Int      @default(0) @map("sort_order")
  isPublished     Boolean  @default(false) @map("is_published")
  version         Int      @default(1)
  updatedByUserId String   @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       User     @relation("FaqItemUpdater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([isPublished, sortOrder])
  @@map("faq_items")
}

model Organization {
  id                       String               @id @default(cuid())
  kind                     OrganizationKind
  type                     OrganizationType
  legalName                String               @map("legal_name")
  displayName              String               @map("display_name")
  nationalId               String?              @unique @map("national_id")
  province                 String?
  city                     String?
  status                   OrganizationStatus   @default(PENDING)
  subscriptionTrialRedeemedAt DateTime?         @map("subscription_trial_redeemed_at") @db.Timestamptz(3)
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  members                  OrganizationMember[]
  scopedRoles              UserRole[]
  buyerRfqs                Rfq[]
  subscriptions            Subscription[]
  manualSubscriptionRenewals ManualSubscriptionRenewal[]
  billingInvoices            BillingInvoice[]
  subscriptionDiscountRedemptions SubscriptionDiscountRedemption[]
  buyerSupplierReviews       SupplierReview[] @relation("BuyerSupplierReviews")
  receivedSupplierReviews    SupplierReview[] @relation("ReceivedSupplierReviews")
  paymentReceipts          PaymentReceipt[]
  creditWallet             CreditWallet?
  supplierProfile          SupplierProfile?
  rfqInvitations           RfqInvitation[]      @relation("InvitedSupplier")
  quotations               Quotation[]          @relation("SupplierQuotations")
  notifications            Notification[]
  attachments              Attachment[]
  buyerMessageThreads      MessageThread[]      @relation("BuyerMessageThreads")
  supplierMessageThreads   MessageThread[]      @relation("SupplierMessageThreads")
  sentMessages             Message[]            @relation("MessageSenderOrganization")
  supportTickets           SupportTicket[]      @relation("SupportTicketOrganization")
  subjectSupportTickets    SupportTicket[]      @relation("SupportTicketSubjectOrganization")
  buyerContractRequests    ContractRequest[]    @relation("BuyerContractRequests")
  supplierContractRequests ContractRequest[]    @relation("SupplierContractRequests")

  @@index([kind, status])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  nameFa      String           @map("name_fa")
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  roleId         String        @map("role_id")
  organizationId String?       @map("organization_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OtpCode {
  id         String     @id @default(cuid())
  mobile     String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  ipAddress  String?    @map("ip_address")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobile, purpose, createdAt])
  @@index([ipAddress, createdAt])
  @@map("otp_codes")
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?  @map("actor_user_id")
  organizationId String?  @map("organization_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id               String                @id @default(cuid())
  eventType        String                @map("event_type")
  severity         SecurityEventSeverity @default(INFO)
  outcome          String
  userId           String?               @map("user_id")
  subjectHash      String?               @map("subject_hash")
  ipAddress        String?               @map("ip_address")
  userAgent        String?               @map("user_agent")
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId String?               @map("resolved_by_user_id")
  user             User?                 @relation("SecurityEventSubject", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy       User?                 @relation("SecurityEventResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([severity, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([resolvedAt, createdAt])
  @@map("security_events")
}

model OutboxEvent {
  id                     String                 @id @default(cuid())
  aggregateType          String                 @map("aggregate_type")
  aggregateId            String                 @map("aggregate_id")
  eventType              String                 @map("event_type")
  payload                Json
  status                 OutboxStatus           @default(PENDING)
  attempts               Int                    @default(0)
  availableAt            DateTime               @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt            DateTime?              @map("processed_at") @db.Timestamptz(3)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  notifications          Notification[]
  notificationDispatches NotificationDispatch[]

  @@index([status, availableAt])
  @@map("outbox_events")
}

model NotificationTemplate {
  id                 String              @id @default(cuid())
  code               String              @unique
  eventType          String              @map("event_type")
  channel            NotificationChannel
  locale             String              @default("fa-IR")
  titleTemplate      String              @map("title_template")
  bodyTemplate       String              @map("body_template")
  actionPathTemplate String?             @map("action_path_template")
  isActive           Boolean             @default(true) @map("is_active")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  notifications      Notification[]

  @@unique([eventType, channel, locale])
  @@index([channel, isActive])
  @@map("notification_templates")
}

model NotificationDispatch {
  id             String                     @id @default(cuid())
  sourceEventId  String                     @map("source_event_id")
  channel        NotificationChannel
  status         NotificationDispatchStatus @default(PROCESSED)
  recipientCount Int                        @default(0) @map("recipient_count")
  failureReason  String?                    @map("failure_reason")
  processedAt    DateTime                   @default(now()) @map("processed_at") @db.Timestamptz(3)
  sourceEvent    OutboxEvent                @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, channel])
  @@index([status, processedAt])
  @@map("notification_dispatches")
}

model Notification {
  id              String                @id @default(cuid())
  recipientUserId String                @map("recipient_user_id")
  organizationId  String?               @map("organization_id")
  sourceEventId   String                @map("source_event_id")
  templateId      String?               @map("template_id")
  eventType       String                @map("event_type")
  channel         NotificationChannel   @default(IN_APP)
  status          NotificationStatus    @default(DELIVERED)
  title           String
  body            String
  actionPath      String?               @map("action_path")
  metadata        Json                  @default("{}")
  readAt          DateTime?             @map("read_at") @db.Timestamptz(3)
  deliveredAt     DateTime?             @default(now()) @map("delivered_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient       User                  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sourceEvent     OutboxEvent           @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  template        NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([sourceEventId, recipientUserId, channel])
  @@index([recipientUserId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model Industry {
  id         String     @id @default(cuid())
  code       String     @unique
  nameFa     String     @map("name_fa")
  nameEn     String?    @map("name_en")
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories Category[]
  rfqs       Rfq[]

  @@map("industries")
}

model Category {
  id                 String              @id @default(cuid())
  industryId         String              @map("industry_id")
  parentId           String?             @map("parent_id")
  code               String              @unique
  slug               String              @unique
  nameFa             String              @map("name_fa")
  nameEn             String?             @map("name_en")
  isActive           Boolean             @default(true) @map("is_active")
  sortOrder          Int                 @default(0) @map("sort_order")
  metadata           Json?
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  industry           Industry            @relation(fields: [industryId], references: [id], onDelete: Restrict)
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]          @relation("CategoryTree")
  rfqItems           RfqItem[]
  supplierCategories SupplierCategory[]
  attributeBindings  CategoryAttribute[]

  @@index([industryId, parentId, isActive])
  @@map("categories")
}

model ProductAttributeDefinition {
  id            String                   @id @default(cuid())
  code          String                   @unique
  nameFa        String                   @map("name_fa")
  nameEn        String?                  @map("name_en")
  dataType      ProductAttributeDataType @map("data_type")
  unitLabelFa   String?                  @map("unit_label_fa")
  options       Json                     @default("[]")
  validation    Json                     @default("{}")
  isActive      Boolean                  @default(true) @map("is_active")
  version       Int                      @default(1)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  categoryLinks CategoryAttribute[]

  @@index([isActive, code])
  @@map("product_attribute_definitions")
}

model CategoryAttribute {
  categoryId  String                     @map("category_id")
  attributeId String                     @map("attribute_id")
  isRequired  Boolean                    @default(false) @map("is_required")
  sortOrder   Int                        @default(0) @map("sort_order")
  category    Category                   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute   ProductAttributeDefinition @relation(fields: [attributeId], references: [id], onDelete: Restrict)

  @@id([categoryId, attributeId])
  @@index([attributeId])
  @@map("category_attributes")
}

model UnitOfMeasure {
  id           String    @id @default(cuid())
  code         String    @unique
  nameFa       String    @map("name_fa")
  symbolFa     String    @map("symbol_fa")
  decimalScale Int       @default(2) @map("decimal_scale")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  rfqItems     RfqItem[]

  @@map("units_of_measure")
}

model Province {
  id               String                    @id @default(cuid())
  code             String                    @unique
  nameFa           String                    @unique @map("name_fa")
  nameEn           String?                   @map("name_en")
  sortOrder        Int                       @default(0) @map("sort_order")
  isActive         Boolean                   @default(true) @map("is_active")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)
  cities           City[]
  rfqs             Rfq[]                     @relation("RfqDeliveryProvince")
  supplierCoverage SupplierServiceProvince[]

  @@index([isActive, sortOrder])
  @@map("provinces")
}

model City {
  id                String   @id @default(cuid())
  provinceId        String   @map("province_id")
  code              String
  nameFa            String   @map("name_fa")
  nameEn            String?  @map("name_en")
