  discountCodeId     String                     @map("discount_code_id")
  organizationId     String                     @map("organization_id")
  subscriptionId     String                     @unique @map("subscription_id")
  status             DiscountRedemptionStatus   @default(RESERVED)
  discountAmountRial BigInt                     @map("discount_amount_rial")
  reservedAt         DateTime                   @default(now()) @map("reserved_at") @db.Timestamptz(3)
  redeemedAt         DateTime?                  @map("redeemed_at") @db.Timestamptz(3)
  cancelledAt        DateTime?                  @map("cancelled_at") @db.Timestamptz(3)
  discountCode       SubscriptionDiscountCode   @relation(fields: [discountCodeId], references: [id], onDelete: Restrict)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription       Subscription               @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([discountCodeId, status])
  @@index([discountCodeId, organizationId, status])
  @@map("subscription_discount_redemptions")
}

model ManualSubscriptionRenewal {
  id                String       @id @default(cuid())
  organizationId    String       @map("organization_id")
  subscriptionId    String       @unique @map("subscription_id")
  activatedByUserId String       @map("activated_by_user_id")
  trackingNumber    String       @unique @map("tracking_number")
  amountRial        BigInt       @map("amount_rial")
  paidAt            DateTime     @map("paid_at") @db.Timestamptz(3)
  note              String       @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  activatedBy       User         @relation("ManualSubscriptionRenewalActor", fields: [activatedByUserId], references: [id], onDelete: Restrict)
  billingInvoice    BillingInvoice?

  @@index([organizationId, paidAt])
  @@index([activatedByUserId, createdAt])
  @@map("manual_subscription_renewals")
}

model SubscriptionReminder {
  id             String          @id @default(cuid())
  subscriptionId String          @map("subscription_id")
  offsetDays     Int             @map("offset_days")
  channel        ReminderChannel
  status         ReminderStatus  @default(PENDING)
  scheduledAt    DateTime        @map("scheduled_at") @db.Timestamptz(3)
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  failureReason  String?         @map("failure_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, offsetDays, channel])
  @@index([status, scheduledAt])
  @@map("subscription_reminders")
}

model CreditWallet {
  id                   String              @id @default(cuid())
  organizationId       String              @unique @map("organization_id")
  cachedBalanceCredits BigInt              @default(0) @map("cached_balance_credits")
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries              CreditLedgerEntry[]

  @@map("credit_wallets")
}

model CreditLedgerEntry {
  id             String          @id @default(cuid())
  walletId       String          @map("wallet_id")
  type           CreditEntryType
  amountCredits  BigInt          @map("amount_credits")
  referenceType  String          @map("reference_type")
  referenceId    String          @map("reference_id")
  idempotencyKey String          @unique @map("idempotency_key")
  reasonCode     String?         @map("reason_code")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet         CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("credit_ledger_entries")
}

model PaymentIntent {
  id                  String          @id @default(cuid())
  provider            PaymentProvider
  purpose             PaymentPurpose
  status              PaymentStatus   @default(CREATED)
  amountRial          BigInt          @map("amount_rial")
  payerOrganizationId String?         @map("payer_organization_id")
  referenceType       String          @map("reference_type")
  referenceId         String          @map("reference_id")
  authority           String?         @unique
  providerReference   String?         @map("provider_reference")
  idempotencyKey      String          @unique @map("idempotency_key")
  callbackPayload     Json?           @map("callback_payload")
  verifiedAt          DateTime?       @map("verified_at") @db.Timestamptz(3)
  reconciliationStatus PaymentReconciliationStatus @default(NOT_CHECKED) @map("reconciliation_status")
  lastReconciledAt    DateTime?       @map("last_reconciled_at") @db.Timestamptz(3)
  lastProviderCode    Int?            @map("last_provider_code")
  reconciliationResolution PaymentReconciliationResolution? @map("reconciliation_resolution")
  reconciliationResolutionNote String? @map("reconciliation_resolution_note") @db.Text
  reconciliationResolvedAt DateTime?  @map("reconciliation_resolved_at") @db.Timestamptz(3)
  reconciliationResolvedByUserId String? @map("reconciliation_resolved_by_user_id")
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  paymentReceipt      PaymentReceipt?
  billingInvoice      BillingInvoice?
  reconciliationResolvedBy User?      @relation("PaymentReconciliationResolver", fields: [reconciliationResolvedByUserId], references: [id], onDelete: SetNull)

  @@index([referenceType, referenceId])
  @@index([status, createdAt])
  @@index([reconciliationStatus, updatedAt])
  @@index([reconciliationResolvedAt, updatedAt])
  @@map("payment_intents")
}

model BillingInvoice {
  id                    String                @id @default(cuid())
  invoiceNumber         String                @unique @map("invoice_number")
  organizationId        String                @map("organization_id")
  purpose               BillingInvoicePurpose
  status                BillingInvoiceStatus  @default(ISSUED)
  subscriptionId        String?               @unique @map("subscription_id")
  paymentIntentId       String?               @unique @map("payment_intent_id")
  manualRenewalId       String?               @unique @map("manual_renewal_id")
  netAmountRial         BigInt                @map("net_amount_rial")
  taxRial               BigInt                @default(0) @map("tax_rial")
  totalAmountRial       BigInt                @map("total_amount_rial")
  currency              String                @default("IRR")
  descriptionFa         String                @map("description_fa")
  issuedAt              DateTime              @default(now()) @map("issued_at") @db.Timestamptz(3)
  dueAt                 DateTime?             @map("due_at") @db.Timestamptz(3)
  paidAt                DateTime?             @map("paid_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription          Subscription?         @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  paymentIntent         PaymentIntent?        @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)
  manualRenewal         ManualSubscriptionRenewal? @relation(fields: [manualRenewalId], references: [id], onDelete: Restrict)

  @@index([organizationId, issuedAt])
  @@index([status, dueAt])
  @@map("billing_invoices")
}

model PaymentReceipt {
  id                String        @id @default(cuid())
  receiptNumber     String        @unique @map("receipt_number")
  organizationId    String        @map("organization_id")
  subscriptionId    String?       @unique @map("subscription_id")
  qualityControlRequestId String? @unique @map("quality_control_request_id")
  paymentIntentId   String        @unique @map("payment_intent_id")
  amountRial        BigInt        @map("amount_rial")
  taxRial           BigInt        @default(0) @map("tax_rial")
  currency          String        @default("IRR")
  providerReference String?       @map("provider_reference")
  paidAt            DateTime      @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  qualityControlRequest QualityControlRequest? @relation(fields: [qualityControlRequestId], references: [id], onDelete: Restrict)
  paymentIntent     PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Restrict)

  @@index([organizationId, paidAt])
  @@map("payment_receipts")
}

model QualityControlRequest {
  id                  String               @id @default(cuid())
  rfqId               String               @unique @map("rfq_id")
  selectedQuotationId String?              @unique @map("selected_quotation_id")
  status              QualityControlStatus @default(REQUESTED)
  purchaseAmountRial  BigInt?              @map("purchase_amount_rial")
  feeBps              Int                  @default(300) @map("fee_bps")
  feeAmountRial       BigInt?              @map("fee_amount_rial")
  policyVersion       String               @default("QC_V1") @map("policy_version")
  requestedAt         DateTime             @default(now()) @map("requested_at") @db.Timestamptz(3)
  acceptedAt          DateTime?            @map("accepted_at") @db.Timestamptz(3)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(3)
  rfq                 Rfq                  @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  selectedQuotation   Quotation?           @relation(fields: [selectedQuotationId], references: [id], onDelete: Restrict)
  paymentReceipt      PaymentReceipt?

  @@index([status, requestedAt])
  @@map("quality_control_requests")
}

model ContractRequest {
  id                     String                @id @default(cuid())
  code                   String                @unique
  rfqId                  String                @unique @map("rfq_id")
  selectedQuotationId    String                @unique @map("selected_quotation_id")
  buyerOrganizationId    String                @map("buyer_organization_id")
  supplierOrganizationId String                @map("supplier_organization_id")
  requestedByUserId      String                @map("requested_by_user_id")
  status                 ContractRequestStatus @default(REQUESTED)
  buyerNote              String?               @map("buyer_note") @db.Text
  termsSummary           String?               @map("terms_summary") @db.Text
  cancellationReason     String?               @map("cancellation_reason") @db.Text
  requestedAt            DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  reviewedAt             DateTime?             @map("reviewed_at") @db.Timestamptz(3)
  termsPreparedAt        DateTime?             @map("terms_prepared_at") @db.Timestamptz(3)
  acceptedAt             DateTime?             @map("accepted_at") @db.Timestamptz(3)
  completedAt            DateTime?             @map("completed_at") @db.Timestamptz(3)
  cancelledAt            DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  rfq                    Rfq                   @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  selectedQuotation      Quotation             @relation(fields: [selectedQuotationId], references: [id], onDelete: Restrict)
  buyerOrganization      Organization          @relation("BuyerContractRequests", fields: [buyerOrganizationId], references: [id], onDelete: Restrict)
  supplierOrganization   Organization          @relation("SupplierContractRequests", fields: [supplierOrganizationId], references: [id], onDelete: Restrict)
  requestedBy            User                  @relation("ContractRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@index([buyerOrganizationId, requestedAt])
  @@index([supplierOrganizationId, requestedAt])
  @@map("contract_requests")
}

model SystemSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         Json
  descriptionFa String?  @map("description_fa")
  isEditable    Boolean  @default(true) @map("is_editable")
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
