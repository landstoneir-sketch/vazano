# Copy to .env.production on the deployment host and load real secrets from a secret manager.
# Use immutable tags or digests for every image.
VAZANO_API_IMAGE=registry.example/vazano-api:git-sha
VAZANO_WEB_IMAGE=registry.example/vazano-web:git-sha
VAZANO_MIGRATION_IMAGE=registry.example/vazano-migration:git-sha
VAZANO_GATEWAY_IMAGE=nginx:approved-pinned-version
VAZANO_ENV_FILE=.env.production
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080

NODE_ENV=production
TZ=Asia/Tehran
API_PORT=3001
WEB_ORIGIN=https://vazano.ir
TRUST_PROXY_HOPS=1
DATABASE_URL=
REDIS_URL=rediss://redis.example:6379
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_IP_REQUESTS_PER_MINUTE=10
OTP_PEPPER=
OTP_DEBUG_ENABLED=false
SMS_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=961076
SMSIR_CODE_PARAMETER=Code
SUBSCRIPTION_SMS_ENABLED=false
SMSIR_SUBSCRIPTION_RENEWAL_14_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_RENEWAL_7_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_RENEWAL_3_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_EXPIRED_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_GRACE_ENDED_TEMPLATE_ID=

S3_ENDPOINT=https://storage.example
S3_REGION=us-east-1
S3_BUCKET=vazano-production
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
ATTACHMENT_MAX_SIZE_BYTES=20971520
FILE_SCAN_MODE=clamav
CLAMAV_HOST=clamav.example
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

PAYMENT_PROVIDER=zarinpal
ZARINPAL_ENABLED=false
ZARINPAL_MERCHANT_ID=replace_only_when_enabled
ZARINPAL_SANDBOX=false
PUBLIC_API_URL=https://vazano.ir
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
SUBSCRIPTION_LIFECYCLE_WORKER_ENABLED=true
SUBSCRIPTION_LIFECYCLE_WORKER_INTERVAL_MS=60000
SEED_DEMO_DATA=false
