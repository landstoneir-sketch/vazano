# Production deployment template. Copy to .env.production and replace every placeholder.
# Never commit the completed .env.production file.
VAZANO_ENV_FILE=.env.production
VAZANO_API_IMAGE=ghcr.io/your-org/vazano-api:replace-with-git-sha
VAZANO_WEB_IMAGE=ghcr.io/your-org/vazano-web:replace-with-git-sha
VAZANO_MIGRATION_IMAGE=ghcr.io/your-org/vazano-migration:replace-with-git-sha
VAZANO_GATEWAY_IMAGE=nginx@sha256:4ff102c5d78d254a6f0da062b3cf39eaf07f01eec0927fd21e219d0af8bc0591
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8080

NODE_ENV=production
TZ=Asia/Tehran
API_PORT=3001
WEB_ORIGIN=https://vazano.ir
PUBLIC_API_URL=https://vazano.ir
TRUST_PROXY_HOPS=1

DATABASE_URL=postgresql://vazano:replace_with_database_password@database.internal:5432/vazano?schema=public
REDIS_URL=redis://redis.internal:6379
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_IP_REQUESTS_PER_MINUTE=10
OTP_PEPPER=replace_with_cryptographically_random_value_at_least_32_characters
OTP_DEBUG_ENABLED=false

SMS_PROVIDER=smsir
SMSIR_API_KEY=replace_with_smsir_api_key
SMSIR_TEMPLATE_ID=961076
SMSIR_CODE_PARAMETER=Code
SUBSCRIPTION_SMS_ENABLED=false
SMSIR_SUBSCRIPTION_RENEWAL_14_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_RENEWAL_7_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_RENEWAL_3_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_EXPIRED_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_GRACE_ENDED_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_7_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_3_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_1_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_ENDED_TEMPLATE_ID=

S3_ENDPOINT=https://storage.vazano.ir
S3_REGION=us-east-1
S3_BUCKET=vazano-production
S3_ACCESS_KEY=replace_with_storage_access_key
S3_SECRET_KEY=replace_with_storage_secret_key
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
ATTACHMENT_MAX_SIZE_BYTES=20971520
FILE_SCAN_MODE=clamav
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

PAYMENT_PROVIDER=zarinpal
ZARINPAL_ENABLED=false
ZARINPAL_SANDBOX=false
ZARINPAL_MERCHANT_ID=

SEED_ADMIN_MOBILE=replace_with_owner_mobile
SEED_DEMO_DATA=false
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
SUBSCRIPTION_LIFECYCLE_WORKER_ENABLED=true
SUBSCRIPTION_LIFECYCLE_WORKER_INTERVAL_MS=60000
