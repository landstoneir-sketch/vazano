# Vazano development configuration — never place production secrets here.
NODE_ENV=development
TZ=Asia/Tehran
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/v1
# Server-side URL used by the web route guard (for Docker: http://api:3001/v1).
API_INTERNAL_URL=http://localhost:3001/v1
TRUST_PROXY_HOPS=0
POSTGRES_DB=vazano
POSTGRES_USER=vazano
POSTGRES_PASSWORD=change_me_for_shared_environments
DATABASE_URL=postgresql://vazano:change_me_for_shared_environments@localhost:55432/vazano?schema=public
REDIS_URL=redis://localhost:56379
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_IP_REQUESTS_PER_MINUTE=10
OTP_PEPPER=replace_with_a_long_random_value
OTP_DEBUG_ENABLED=true
OTP_DEBUG_CODE=11111
SMS_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=961076
SMSIR_CODE_PARAMETER=Code
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=vazano-dev
S3_ACCESS_KEY=vazano
S3_SECRET_KEY=replace_me
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_URL_TTL_SECONDS=300
S3_DOWNLOAD_URL_TTL_SECONDS=300
ATTACHMENT_MAX_SIZE_BYTES=20971520
# Development may bypass scanning. Production validation requires the ClamAV adapter.
FILE_SCAN_MODE=development-bypass
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
PAYMENT_PROVIDER=zarinpal
ZARINPAL_MERCHANT_ID=
PUBLIC_API_URL=http://localhost:3001
ZARINPAL_SANDBOX=true
SEED_ADMIN_MOBILE=09120000000
SEED_DEMO_DATA=true
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=15000
SUBSCRIPTION_LIFECYCLE_WORKER_ENABLED=true
SUBSCRIPTION_LIFECYCLE_WORKER_INTERVAL_MS=60000
# Zarinpal is disabled by default; secrets must only exist in local/secret-manager configuration.
ZARINPAL_ENABLED=false
