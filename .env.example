NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://vazano:change_me@127.0.0.1:55432/vazano?schema=public
SESSION_TTL_DAYS=30
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=replace_with_a_long_random_value
OTP_DEBUG_ENABLED=true
OTP_DEBUG_CODE=11111
SMS_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=961076
SMSIR_CODE_PARAMETER=Code
SUBSCRIPTION_SMS_ENABLED=false
SMSIR_SUBSCRIPTION_RENEWAL_14_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_RENEWAL_7_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_RENEWAL_3_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_EXPIRED_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_GRACE_ENDED_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_7_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_3_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_1_TEMPLATE_ID=
SMSIR_SUBSCRIPTION_TRIAL_ENDED_TEMPLATE_ID=
SEED_ADMIN_MOBILE=09120000000
SEED_DEMO_DATA=true
# Payment gateway abstraction — disabled safely until a real merchant ID is configured.
PAYMENT_PROVIDER=zarinpal
ZARINPAL_ENABLED=false
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=
PUBLIC_API_URL=http://localhost:3001
# Optional endpoint overrides for provider changes or private routing:
# ZARINPAL_REQUEST_URL=
# ZARINPAL_VERIFY_URL=
# ZARINPAL_START_PAY_URL=
