# ==============================
# پیکربندی محیط وازانو (نمونه)
# هیچ مقدار واقعی در این فایل قرار ندهید.
# ==============================

# آدرس عمومی سایت
NEXT_PUBLIC_APP_URL=https://vazano.example.com

# --- Backend API (در انتظار پیاده‌سازی) ---
NEXT_PUBLIC_API_BASE_URL=https://api.vazano.example.com
API_INTERNAL_SECRET=

# --- احراز هویت / OTP ---
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SENDER=

# --- پایگاه داده (برای Backend آینده) ---
DATABASE_URL=postgresql://user:password@localhost:5432/vazano
REDIS_URL=redis://localhost:6379

# --- ذخیره‌سازی فایل ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# --- درگاه پرداخت ---
PAYMENT_GATEWAY_MERCHANT_ID=
PAYMENT_GATEWAY_CALLBACK_URL=

# --- پیامک ---
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_LINE=

# --- هوش مصنوعی (AI Gateway) ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=

# --- نظارت و لاگ ---
SENTRY_DSN=
LOG_LEVEL=info
