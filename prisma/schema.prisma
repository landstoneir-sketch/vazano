generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum SecurityEventSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OrganizationType {
  INDIVIDUAL
  COMPANY
}

enum OrganizationKind {
  BUYER
  SUPPLIER
  PLATFORM
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  BUYER_OWNER
  BUYER_MEMBER
  SUPPLIER_OWNER
  SUPPLIER_MANAGER
  SUPPLIER_SALES
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum OtpPurpose {
  LOGIN
  SIGNUP
  RESET
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RfqEntryMethod {
  STANDARD
  CONVERSATIONAL
  BOQ
  IMAGE
  DRAWING
  NAMEPLATE
  FILE
}

enum RfqLifecycleState {
  DRAFT
  SUBMITTED
  PUBLISHED
  CLOSED
  CANCELLED
  EXPIRED
  ARCHIVED
}

enum RfqOperationalStatus {
  DRAFT_INCOMPLETE
  READY_FOR_REVIEW
  UNDER_REVIEW
  NEEDS_CHANGES
  WAITING_COMMITMENT
  READY_TO_PUBLISH
  OPEN_FOR_QUOTES
  HAS_QUOTES
  NEGOTIATING
  SELLER_SELECTED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum RfqApprovalStatus {
  NOT_SUBMITTED
  PENDING
  NEEDS_CHANGES
  APPROVED
  REJECTED
}

enum RfqSource {
  BUYER_SELF_SERVICE
  PLATFORM_OPERATOR
}

enum CommitmentStatus {
  NOT_REQUIRED
  REQUIRED
  PAYMENT_PENDING
  HELD
  RELEASED_TO_WALLET
  REFUND_PENDING
  REFUNDED
  FORFEITED
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  GRACE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  P1M
  P3M
  P6M
  P1Y
  CUSTOM
}

enum ReminderChannel {
  SMS
  IN_APP
  EMAIL
}

enum ReminderStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

enum NotificationStatus {
  READY
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationDispatchStatus {
  PROCESSED
  FAILED
}

enum AttachmentStatus {
  PENDING_UPLOAD
  PENDING_SCAN
  READY
  QUARANTINED
  REJECTED
  DELETED
}

enum AttachmentPurpose {
  GENERAL
  PRODUCT_IMAGE
  DRAWING
  BILL_OF_QUANTITIES
  SPECIFICATION
  PROFORMA
  CERTIFICATE
}

enum MessageThreadStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum MessageKind {
  USER
  SYSTEM
}

enum PaymentProvider {
  ZARINPAL
  MOCK
}

enum PaymentPurpose {
  SUBSCRIPTION
  BUYER_COMMITMENT
  QUALITY_CONTROL
}

enum PaymentStatus {
  CREATED
  REDIRECT_PENDING
  VERIFY_PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CreditEntryType {
  GRANT
  RESERVE
  CONSUME
  RELEASE
  REFUND
  EXPIRE
  ADJUSTMENT
}

enum QualityControlStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SupplierVerificationStatus {
  INCOMPLETE
  PENDING
  VERIFIED
  NEEDS_CORRECTION
  REJECTED
  SUSPENDED
}

enum RfqInvitationStatus {
  INVITED
  VIEWED
  RESPONDED
  DECLINED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  REVISED
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SupportTicketType {
  QUESTION
  SERVICE_REQUEST
  ISSUE
  COMPLAINT
  VIOLATION_REPORT
  APPEAL
}

enum SupportTicketCategory {
  PRODUCT_TECHNICAL
  ACCOUNT_ACCESS
  RFQ
  QUOTATION
  SUPPLIER_BUYER_CONDUCT
  BILLING
  PRIVACY_SECURITY
  COMMUNICATION
  POLICY
  OTHER
}

enum SupportTicketPriority {
  P1
  P2
  P3
  P4
}

enum SupportTicketStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_REVIEW
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REJECTED
}

model User {
  id                      String                   @id @default(cuid())
  mobile                  String                   @unique
  email                   String?                  @unique
  firstName               String?                  @map("first_name")
  lastName                String?                  @map("last_name")
  locale                  String                   @default("fa-IR")
  status                  UserStatus               @default(ACTIVE)
  mobileVerifiedAt        DateTime?                @map("mobile_verified_at") @db.Timestamptz(3)
  emailVerifiedAt         DateTime?                @map("email_verified_at") @db.Timestamptz(3)
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships             OrganizationMember[]
  sessions                Session[]
  userRoles               UserRole[]
  auditLogs               AuditLog[]
  createdRfqs             Rfq[]                    @relation("RfqCreator")
  buyerContactRfqs        Rfq[]                    @relation("RfqBuyerContact")
  operatedRfqs            Rfq[]                    @relation("RfqOperator")
  createdQuotations       Quotation[]              @relation("QuotationCreator")
  notifications           Notification[]
  uploadedAttachments     Attachment[]             @relation("AttachmentUploader")
  sentMessages            Message[]                @relation("MessageSender")
  messageReadStates       MessageThreadReadState[]
  requestedSupportTickets SupportTicket[]          @relation("SupportTicketRequester")
  assignedSupportTickets  SupportTicket[]          @relation("SupportTicketAssignee")
  supportComments         SupportTicketComment[]   @relation("SupportCommentAuthor")
  securityEvents          SecurityEvent[]          @relation("SecurityEventSubject")
  resolvedSecurityEvents  SecurityEvent[]          @relation("SecurityEventResolver")

  @@map("users")
}

model Organization {
  id                     String               @id @default(cuid())
  kind                   OrganizationKind
  type                   OrganizationType
  legalName              String               @map("legal_name")
  displayName            String               @map("display_name")
  nationalId             String?              @unique @map("national_id")
  province               String?
  city                   String?
  status                 OrganizationStatus   @default(PENDING)
  createdAt              DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  members                OrganizationMember[]
  scopedRoles            UserRole[]
  buyerRfqs              Rfq[]
  subscriptions          Subscription[]
  creditWallet           CreditWallet?
  supplierProfile        SupplierProfile?
  rfqInvitations         RfqInvitation[]      @relation("InvitedSupplier")
  quotations             Quotation[]          @relation("SupplierQuotations")
  notifications          Notification[]
  attachments            Attachment[]
  buyerMessageThreads    MessageThread[]      @relation("BuyerMessageThreads")
  supplierMessageThreads MessageThread[]      @relation("SupplierMessageThreads")
  sentMessages           Message[]            @relation("MessageSenderOrganization")
  supportTickets         SupportTicket[]      @relation("SupportTicketOrganization")
  subjectSupportTickets  SupportTicket[]      @relation("SupportTicketSubjectOrganization")

  @@index([kind, status])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           MemberRole
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@map("organization_members")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  nameFa      String           @map("name_fa")
  description String?
  isSystem    Boolean          @default(true) @map("is_system")
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String        @id @default(cuid())
  userId         String        @map("user_id")
  roleId         String        @map("role_id")
  organizationId String?       @map("organization_id")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId])
  @@map("user_roles")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model OtpCode {
  id         String     @id @default(cuid())
  mobile     String
  purpose    OtpPurpose
  codeHash   String     @map("code_hash")
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([mobile, purpose, createdAt])
  @@map("otp_codes")
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?  @map("actor_user_id")
  organizationId String?  @map("organization_id")
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}

model SecurityEvent {
  id               String                @id @default(cuid())
  eventType        String                @map("event_type")
  severity         SecurityEventSeverity @default(INFO)
  outcome          String
  userId           String?               @map("user_id")
  subjectHash      String?               @map("subject_hash")
  ipAddress        String?               @map("ip_address")
  userAgent        String?               @map("user_agent")
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?             @map("resolved_at") @db.Timestamptz(3)
  resolvedByUserId String?               @map("resolved_by_user_id")
  user             User?                 @relation("SecurityEventSubject", fields: [userId], references: [id], onDelete: SetNull)
  resolvedBy       User?                 @relation("SecurityEventResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([severity, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([resolvedAt, createdAt])
  @@map("security_events")
}

model OutboxEvent {
  id                     String                 @id @default(cuid())
  aggregateType          String                 @map("aggregate_type")
  aggregateId            String                 @map("aggregate_id")
  eventType              String                 @map("event_type")
  payload                Json
  status                 OutboxStatus           @default(PENDING)
  attempts               Int                    @default(0)
  availableAt            DateTime               @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt            DateTime?              @map("processed_at") @db.Timestamptz(3)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  notifications          Notification[]
  notificationDispatches NotificationDispatch[]

  @@index([status, availableAt])
  @@map("outbox_events")
}

model NotificationTemplate {
  id                 String              @id @default(cuid())
  code               String              @unique
  eventType          String              @map("event_type")
  channel            NotificationChannel
  locale             String              @default("fa-IR")
  titleTemplate      String              @map("title_template")
  bodyTemplate       String              @map("body_template")
  actionPathTemplate String?             @map("action_path_template")
  isActive           Boolean             @default(true) @map("is_active")
  version            Int                 @default(1)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  notifications      Notification[]

  @@unique([eventType, channel, locale])
  @@index([channel, isActive])
  @@map("notification_templates")
}

model NotificationDispatch {
  id             String                     @id @default(cuid())
  sourceEventId  String                     @map("source_event_id")
  channel        NotificationChannel
  status         NotificationDispatchStatus @default(PROCESSED)
  recipientCount Int                        @default(0) @map("recipient_count")
  failureReason  String?                    @map("failure_reason")
  processedAt    DateTime                   @default(now()) @map("processed_at") @db.Timestamptz(3)
  sourceEvent    OutboxEvent                @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)

  @@unique([sourceEventId, channel])
  @@index([status, processedAt])
  @@map("notification_dispatches")
}

model Notification {
  id              String                @id @default(cuid())
  recipientUserId String                @map("recipient_user_id")
  organizationId  String?               @map("organization_id")
  sourceEventId   String                @map("source_event_id")
  templateId      String?               @map("template_id")
  eventType       String                @map("event_type")
  channel         NotificationChannel   @default(IN_APP)
  status          NotificationStatus    @default(DELIVERED)
  title           String
  body            String
  actionPath      String?               @map("action_path")
  metadata        Json                  @default("{}")
  readAt          DateTime?             @map("read_at") @db.Timestamptz(3)
  deliveredAt     DateTime?             @default(now()) @map("delivered_at") @db.Timestamptz(3)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  recipient       User                  @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  organization    Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  sourceEvent     OutboxEvent           @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  template        NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([sourceEventId, recipientUserId, channel])
  @@index([recipientUserId, readAt, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("notifications")
}

model Industry {
  id         String     @id @default(cuid())
  code       String     @unique
  nameFa     String     @map("name_fa")
  nameEn     String?    @map("name_en")
  isActive   Boolean    @default(true) @map("is_active")
  sortOrder  Int        @default(0) @map("sort_order")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  categories Category[]
  rfqs       Rfq[]

  @@map("industries")
}

model Category {
  id                 String             @id @default(cuid())
  industryId         String             @map("industry_id")
  parentId           String?            @map("parent_id")
  code               String             @unique
  slug               String             @unique
  nameFa             String             @map("name_fa")
  nameEn             String?            @map("name_en")
  isActive           Boolean            @default(true) @map("is_active")
  sortOrder          Int                @default(0) @map("sort_order")
  metadata           Json?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  industry           Industry           @relation(fields: [industryId], references: [id], onDelete: Restrict)
  parent             Category?          @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children           Category[]         @relation("CategoryTree")
  rfqItems           RfqItem[]
  supplierCategories SupplierCategory[]

  @@index([industryId, parentId, isActive])
  @@map("categories")
}

model UnitOfMeasure {
  id           String    @id @default(cuid())
  code         String    @unique
  nameFa       String    @map("name_fa")
  symbolFa     String    @map("symbol_fa")
  decimalScale Int       @default(2) @map("decimal_scale")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  rfqItems     RfqItem[]

  @@map("units_of_measure")
}

model Rfq {
  id                        String                 @id @default(cuid())
  code                      String                 @unique
  buyerOrganizationId       String                 @map("buyer_organization_id")
  buyerContactUserId        String                 @map("buyer_contact_user_id")
  createdByUserId           String                 @map("created_by_user_id")
  operatorUserId            String?                @map("operator_user_id")
  primaryDomainId           String                 @map("primary_domain_id")
  title                     String
  description               String?
  entryMethod               RfqEntryMethod         @default(STANDARD) @map("entry_method")
  lifecycleState            RfqLifecycleState      @default(DRAFT) @map("lifecycle_state")
  operationalStatus         RfqOperationalStatus   @default(DRAFT_INCOMPLETE) @map("operational_status")
  approvalStatus            RfqApprovalStatus      @default(NOT_SUBMITTED) @map("approval_status")
  source                    RfqSource              @default(BUYER_SELF_SERVICE)
  manualReviewRequired      Boolean                @default(true) @map("manual_review_required")
  commitmentStatus          CommitmentStatus       @default(NOT_REQUIRED) @map("commitment_status")
  commitmentAmountRial      BigInt?                @map("commitment_amount_rial")
  commitmentPolicyVersion   String?                @map("commitment_policy_version")
  deliveryProvince          String?                @map("delivery_province")
  deliveryCity              String?                @map("delivery_city")
  requiredAt                DateTime?              @map("required_at") @db.Timestamptz(3)
  responseDeadline          DateTime?              @map("response_deadline") @db.Timestamptz(3)
  installationRequired      Boolean                @default(false) @map("installation_required")
  qualityControlRequested   Boolean                @default(false) @map("quality_control_requested")
  qualityControlFeeBps      Int?                   @map("quality_control_fee_bps")
  displayPricesTaxInclusive Boolean                @default(false) @map("display_prices_tax_inclusive")
  submittedAt               DateTime?              @map("submitted_at") @db.Timestamptz(3)
  publishedAt               DateTime?              @map("published_at") @db.Timestamptz(3)
  closedAt                  DateTime?              @map("closed_at") @db.Timestamptz(3)
  createdAt                 DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  buyerOrganization         Organization           @relation(fields: [buyerOrganizationId], references: [id], onDelete: Restrict)
  buyerContact              User                   @relation("RfqBuyerContact", fields: [buyerContactUserId], references: [id], onDelete: Restrict)
  createdBy                 User                   @relation("RfqCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  operator                  User?                  @relation("RfqOperator", fields: [operatorUserId], references: [id], onDelete: Restrict)
  primaryDomain             Industry               @relation(fields: [primaryDomainId], references: [id], onDelete: Restrict)
  items                     RfqItem[]
  qualityControlRequest     QualityControlRequest?
  invitations               RfqInvitation[]
  quotations                Quotation[]
  attachments               Attachment[]
  messageThreads            MessageThread[]
  supportTickets            SupportTicket[]

  @@index([buyerOrganizationId, createdAt])
  @@index([lifecycleState, operationalStatus])
  @@index([approvalStatus, manualReviewRequired])
  @@map("rfqs")
}

model RfqItem {
  id                     String          @id @default(cuid())
  rfqId                  String          @map("rfq_id")
  categoryId             String          @map("category_id")
  unitId                 String          @map("unit_id")
  title                  String
  quantity               Decimal         @db.Decimal(20, 4)
  specifications         Json            @default("{}")
  estimatedLineValueRial BigInt?         @map("estimated_line_value_rial")
  sortOrder              Int             @default(0) @map("sort_order")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  rfq                    Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  category               Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  unit                   UnitOfMeasure   @relation(fields: [unitId], references: [id], onDelete: Restrict)
  quotationItems         QuotationItem[]

  @@index([rfqId, sortOrder])
  @@index([categoryId])
  @@map("rfq_items")
}

model SupplierProfile {
  id                 String                     @id @default(cuid())
  organizationId     String                     @unique @map("organization_id")
  verificationStatus SupplierVerificationStatus @default(INCOMPLETE) @map("verification_status")
  description        String?
  nationwideCoverage Boolean                    @default(false) @map("nationwide_coverage")
  serviceProvinces   String[]                   @default([]) @map("service_provinces")
  verificationReason String?                    @map("verification_reason")
  verifiedAt         DateTime?                  @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categories         SupplierCategory[]

  @@index([verificationStatus, nationwideCoverage])
  @@map("supplier_profiles")
}

model SupplierCategory {
  supplierProfileId String          @map("supplier_profile_id")
  categoryId        String          @map("category_id")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  supplierProfile   SupplierProfile @relation(fields: [supplierProfileId], references: [id], onDelete: Cascade)
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([supplierProfileId, categoryId])
  @@index([categoryId])
  @@map("supplier_categories")
}

model RfqInvitation {
  id                     String              @id @default(cuid())
  rfqId                  String              @map("rfq_id")
  supplierOrganizationId String              @map("supplier_organization_id")
  status                 RfqInvitationStatus @default(INVITED)
  matchReasons           Json                @default("{}") @map("match_reasons")
  invitedAt              DateTime            @default(now()) @map("invited_at") @db.Timestamptz(3)
  viewedAt               DateTime?           @map("viewed_at") @db.Timestamptz(3)
  respondedAt            DateTime?           @map("responded_at") @db.Timestamptz(3)
  declinedAt             DateTime?           @map("declined_at") @db.Timestamptz(3)
  rfq                    Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierOrganization   Organization        @relation("InvitedSupplier", fields: [supplierOrganizationId], references: [id], onDelete: Restrict)

  @@unique([rfqId, supplierOrganizationId])
  @@index([supplierOrganizationId, status, invitedAt])
  @@map("rfq_invitations")
}

model Quotation {
  id                     String          @id @default(cuid())
  code                   String          @unique
  rfqId                  String          @map("rfq_id")
  supplierOrganizationId String          @map("supplier_organization_id")
  createdByUserId        String          @map("created_by_user_id")
  version                Int             @default(1)
  status                 QuotationStatus @default(DRAFT)
  currency               String          @default("IRR")
  paymentTerms           String?         @map("payment_terms")
  preparationDays        Int?            @map("preparation_days")
  deliveryDate           DateTime?       @map("delivery_date") @db.Timestamptz(3)
  validUntil             DateTime?       @map("valid_until") @db.Timestamptz(3)
  subtotalRial           BigInt          @default(0) @map("subtotal_rial")
  discountRial           BigInt          @default(0) @map("discount_rial")
  taxRial                BigInt          @default(0) @map("tax_rial")
  packagingRial          BigInt          @default(0) @map("packaging_rial")
  loadingRial            BigInt          @default(0) @map("loading_rial")
  shippingRial           BigInt          @default(0) @map("shipping_rial")
  otherCostsRial         BigInt          @default(0) @map("other_costs_rial")
  finalAmountRial        BigInt          @default(0) @map("final_amount_rial")
  submittedAt            DateTime?       @map("submitted_at") @db.Timestamptz(3)
  withdrawnAt            DateTime?       @map("withdrawn_at") @db.Timestamptz(3)
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  rfq                    Rfq             @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  supplierOrganization   Organization    @relation("SupplierQuotations", fields: [supplierOrganizationId], references: [id], onDelete: Restrict)
  createdBy              User            @relation("QuotationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  items                  QuotationItem[]
  attachments            Attachment[]

  @@unique([rfqId, supplierOrganizationId, version])
  @@index([rfqId, status, submittedAt])
  @@index([supplierOrganizationId, status, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id                 String    @id @default(cuid())
  quotationId        String    @map("quotation_id")
  rfqItemId          String    @map("rfq_item_id")
  quantity           Decimal   @db.Decimal(20, 4)
  unitPriceRial      BigInt    @map("unit_price_rial")
  discountRial       BigInt    @default(0) @map("discount_rial")
  lineSubtotalRial   BigInt    @map("line_subtotal_rial")
  lineNetRial        BigInt    @map("line_net_rial")
  isAlternative      Boolean   @default(false) @map("is_alternative")
  offeredDescription String?   @map("offered_description")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  quotation          Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem            RfqItem   @relation(fields: [rfqItemId], references: [id], onDelete: Restrict)

  @@unique([quotationId, rfqItemId])
  @@index([rfqItemId])
  @@map("quotation_items")
}

model Attachment {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  uploadedByUserId String            @map("uploaded_by_user_id")
  rfqId            String?           @map("rfq_id")
  quotationId      String?           @map("quotation_id")
  purpose          AttachmentPurpose @default(GENERAL)
  status           AttachmentStatus  @default(PENDING_UPLOAD)
  bucket           String
  storageKey       String            @unique @map("storage_key")
  originalName     String            @map("original_name")
  mimeType         String            @map("mime_type")
  sizeBytes        Int               @map("size_bytes")
  checksumSha256   String?           @map("checksum_sha256")
  scanProvider     String?           @map("scan_provider")
  scanReason       String?           @map("scan_reason")
  uploadedAt       DateTime?         @map("uploaded_at") @db.Timestamptz(3)
  scannedAt        DateTime?         @map("scanned_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy       User              @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  rfq              Rfq?              @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotation        Quotation?        @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([rfqId, status, createdAt])
  @@index([quotationId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, createdAt])
  @@map("attachments")
}

model MessageThread {
  id                     String                   @id @default(cuid())
  rfqId                  String                   @map("rfq_id")
  buyerOrganizationId    String                   @map("buyer_organization_id")
  supplierOrganizationId String                   @map("supplier_organization_id")
  status                 MessageThreadStatus      @default(OPEN)
  lastMessageAt          DateTime?                @map("last_message_at") @db.Timestamptz(3)
  createdAt              DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  rfq                    Rfq                      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  buyerOrganization      Organization             @relation("BuyerMessageThreads", fields: [buyerOrganizationId], references: [id], onDelete: Restrict)
  supplierOrganization   Organization             @relation("SupplierMessageThreads", fields: [supplierOrganizationId], references: [id], onDelete: Restrict)
  messages               Message[]
  readStates             MessageThreadReadState[]

  @@unique([rfqId, supplierOrganizationId])
  @@index([buyerOrganizationId, lastMessageAt])
  @@index([supplierOrganizationId, lastMessageAt])
  @@map("message_threads")
}

model Message {
  id                   String        @id @default(cuid())
  threadId             String        @map("thread_id")
  senderUserId         String        @map("sender_user_id")
  senderOrganizationId String        @map("sender_organization_id")
  kind                 MessageKind   @default(USER)
  body                 String
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  thread               MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender               User          @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  senderOrganization   Organization  @relation("MessageSenderOrganization", fields: [senderOrganizationId], references: [id], onDelete: Restrict)

  @@index([threadId, createdAt])
  @@index([senderUserId, createdAt])
  @@map("messages")
}

model MessageThreadReadState {
  threadId   String        @map("thread_id")
  userId     String        @map("user_id")
  lastReadAt DateTime      @map("last_read_at") @db.Timestamptz(3)
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId, lastReadAt])
  @@map("message_thread_read_states")
}

model SupportTicket {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  requesterUserId       String                 @map("requester_user_id")
  organizationId        String?                @map("organization_id")
  subjectOrganizationId String?                @map("subject_organization_id")
  relatedRfqId          String?                @map("related_rfq_id")
  assignedToUserId      String?                @map("assigned_to_user_id")
  type                  SupportTicketType
  category              SupportTicketCategory
  priority              SupportTicketPriority  @default(P4)
  status                SupportTicketStatus    @default(SUBMITTED)
  subject               String
  description           String
  resolution            String?
  acknowledgedAt        DateTime?              @map("acknowledged_at") @db.Timestamptz(3)
  resolvedAt            DateTime?              @map("resolved_at") @db.Timestamptz(3)
  closedAt              DateTime?              @map("closed_at") @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  requester             User                   @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  organization          Organization?          @relation("SupportTicketOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  subjectOrganization   Organization?          @relation("SupportTicketSubjectOrganization", fields: [subjectOrganizationId], references: [id], onDelete: Restrict)
  relatedRfq            Rfq?                   @relation(fields: [relatedRfqId], references: [id], onDelete: SetNull)
  assignedTo            User?                  @relation("SupportTicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  comments              SupportTicketComment[]

  @@index([requesterUserId, createdAt])
  @@index([organizationId, createdAt])
  @@index([status, priority, createdAt])
  @@index([assignedToUserId, status])
  @@map("support_tickets")
}

model SupportTicketComment {
  id           String        @id @default(cuid())
  ticketId     String        @map("ticket_id")
  authorUserId String        @map("author_user_id")
  body         String
  isInternal   Boolean       @default(false) @map("is_internal")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User          @relation("SupportCommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_ticket_comments")
}

model SubscriptionPlan {
  id                 String         @id @default(cuid())
  code               String         @unique
  nameFa             String         @map("name_fa")
  descriptionFa      String?        @map("description_fa")
  billingCycle       BillingCycle   @map("billing_cycle")
  durationIso        String         @map("duration_iso")
  priceRial          BigInt         @map("price_rial")
  grantCredits       BigInt         @map("grant_credits")
  dailyProposalLimit Int            @default(2) @map("daily_proposal_limit")
  maxProposalLimit   Int            @default(6) @map("max_proposal_limit")
  taxIncluded        Boolean        @default(false) @map("tax_included")
  isPublic           Boolean        @default(true) @map("is_public")
  isActive           Boolean        @default(true) @map("is_active")
  version            Int            @default(1)
  entitlements       Json           @default("{}")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  subscriptions      Subscription[]

  @@index([isActive, isPublic])
  @@map("subscription_plans")
}

model Subscription {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  planId              String                 @map("plan_id")
  status              SubscriptionStatus     @default(DRAFT)
  startsAt            DateTime?              @map("starts_at") @db.Timestamptz(3)
  expiresAt           DateTime?              @map("expires_at") @db.Timestamptz(3)
  graceEndsAt         DateTime?              @map("grace_ends_at") @db.Timestamptz(3)
  autoRenewEnabled    Boolean                @default(false) @map("auto_renew_enabled")
  autoRenewConsentAt  DateTime?              @map("auto_renew_consent_at") @db.Timestamptz(3)
  priceRialSnapshot   BigInt                 @map("price_rial_snapshot")
  grantCreditSnapshot BigInt                 @map("grant_credit_snapshot")
  planVersionSnapshot Int                    @map("plan_version_snapshot")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  plan                SubscriptionPlan       @relation(fields: [planId], references: [id], onDelete: Restrict)
  reminders           SubscriptionReminder[]

  @@index([organizationId, status])
  @@index([status, expiresAt])
  @@map("subscriptions")
}

model SubscriptionReminder {
  id             String          @id @default(cuid())
  subscriptionId String          @map("subscription_id")
  offsetDays     Int             @map("offset_days")
  channel        ReminderChannel
  status         ReminderStatus  @default(PENDING)
  scheduledAt    DateTime        @map("scheduled_at") @db.Timestamptz(3)
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(3)
  cancelledAt    DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  failureReason  String?         @map("failure_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, offsetDays, channel])
  @@index([status, scheduledAt])
  @@map("subscription_reminders")
}

model CreditWallet {
  id                   String              @id @default(cuid())
  organizationId       String              @unique @map("organization_id")
  cachedBalanceCredits BigInt              @default(0) @map("cached_balance_credits")
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries              CreditLedgerEntry[]

  @@map("credit_wallets")
}

model CreditLedgerEntry {
  id             String          @id @default(cuid())
  walletId       String          @map("wallet_id")
  type           CreditEntryType
  amountCredits  BigInt          @map("amount_credits")
  referenceType  String          @map("reference_type")
  referenceId    String          @map("reference_id")
  idempotencyKey String          @unique @map("idempotency_key")
  reasonCode     String?         @map("reason_code")
  metadata       Json?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  wallet         CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("credit_ledger_entries")
}

model PaymentIntent {
  id                  String          @id @default(cuid())
  provider            PaymentProvider
  purpose             PaymentPurpose
  status              PaymentStatus   @default(CREATED)
  amountRial          BigInt          @map("amount_rial")
  payerOrganizationId String?         @map("payer_organization_id")
  referenceType       String          @map("reference_type")
  referenceId         String          @map("reference_id")
  authority           String?         @unique
  providerReference   String?         @map("provider_reference")
  idempotencyKey      String          @unique @map("idempotency_key")
  callbackPayload     Json?           @map("callback_payload")
  verifiedAt          DateTime?       @map("verified_at") @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([referenceType, referenceId])
  @@index([status, createdAt])
  @@map("payment_intents")
}

model QualityControlRequest {
  id                 String               @id @default(cuid())
  rfqId              String               @unique @map("rfq_id")
  status             QualityControlStatus @default(REQUESTED)
  purchaseAmountRial BigInt?              @map("purchase_amount_rial")
  feeBps             Int                  @default(300) @map("fee_bps")
  feeAmountRial      BigInt?              @map("fee_amount_rial")
  policyVersion      String               @default("QC_V1") @map("policy_version")
  requestedAt        DateTime             @default(now()) @map("requested_at") @db.Timestamptz(3)
  acceptedAt         DateTime?            @map("accepted_at") @db.Timestamptz(3)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(3)
  rfq                Rfq                  @relation(fields: [rfqId], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@map("quality_control_requests")
}

model SystemSetting {
  id            String   @id @default(cuid())
  key           String   @unique
  value         Json
  descriptionFa String?  @map("description_fa")
  isEditable    Boolean  @default(true) @map("is_editable")
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}
